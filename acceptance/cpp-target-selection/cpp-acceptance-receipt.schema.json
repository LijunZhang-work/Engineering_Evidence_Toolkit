{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/cpp-acceptance-receipt.schema.json",
  "title": "Typed C++ Acceptance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "receipt_type", "subject_id", "environment_scope", "environment_content_id", "observed_at", "producer_tool", "command", "exit_code", "dependencies", "raw_artifacts", "attestation", "result"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "CppAcceptanceReceipt"},
    "receipt_type": {"enum": ["SELECTION", "ENVIRONMENT_DISCOVERY", "BUILD_MEASUREMENT"]},
    "subject_id": {"type": "string", "minLength": 1},
    "environment_scope": {"enum": ["LOCAL_DEVELOPMENT", "COMPANY_QUALIFIED"]},
    "environment_content_id": {"$ref": "#/$defs/digest"},
    "observed_at": {"type": "string", "format": "date-time"},
    "producer_tool": {"$ref": "#/$defs/file_ref"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exit_code": {"const": 0},
    "dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "raw_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_ref", "issued_by"],
      "properties": {
        "authority_ref": {"type": "string", "pattern": "^authority_[A-Za-z0-9._-]+$"},
        "issued_by": {"type": "string", "minLength": 1}
      }
    },
    "result": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"receipt_type": {"const": "SELECTION"}}, "required": ["receipt_type"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/selection_result"}}}
    },
    {
      "if": {"properties": {"receipt_type": {"const": "ENVIRONMENT_DISCOVERY"}}, "required": ["receipt_type"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/environment_result"}}}
    },
    {
      "if": {"properties": {"receipt_type": {"const": "BUILD_MEASUREMENT"}}, "required": ["receipt_type"]},
      "then": {"properties": {"result": {"$ref": "#/$defs/build_result"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]{16,}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_id": {"$ref": "#/$defs/digest"}
      }
    },
    "selection_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "commit", "decision", "gate_result", "selection_criteria_content_id"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "decision": {"const": "SELECTED"},
        "gate_result": {"const": "PASS"},
        "selection_criteria_content_id": {"$ref": "#/$defs/digest"}
      }
    },
    "environment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["msvc", "cmake", "ninja"],
      "properties": {
        "msvc": {"$ref": "#/$defs/tool_result"},
        "cmake": {"$ref": "#/$defs/tool_result"},
        "ninja": {"$ref": "#/$defs/tool_result"}
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"const": "AVAILABLE"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "build_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "commit", "generator", "configuration", "clean_build_ms", "incremental_build_ms", "test_status"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "generator": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "clean_build_ms": {"type": "integer", "minimum": 0},
        "incremental_build_ms": {"type": "integer", "minimum": 0},
        "test_status": {"const": "PASSED"}
      }
    }
  }
}
