{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/workspace-snapshot.schema.json",
  "title": "Workspace Snapshot",
  "description": "冻结一次多仓技术工作区和构建画像。协作代码到齐状态由后置 Collaboration Snapshot 独立记录，避免两个快照互相依赖。未知字段必须显式记录，不得由 AI 猜测。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "content_id",
    "provenance_id",
    "repositories",
    "build_context",
    "file_manifest"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^wss_[A-Za-z0-9._-]+$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "captured_by": {"type": "string"},
    "content_id": {"$ref": "#/$defs/digest_id"},
    "provenance_id": {"$ref": "#/$defs/digest_id"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "build_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_environment_status", "profiles"],
      "properties": {
        "target_environment_status": {"enum": ["KNOWN", "PARTIAL", "UNKNOWN"]},
        "profiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/build_profile"}
        },
        "authoritative_profile_id": {"type": "string"},
        "windows_precheck_equivalence": {
          "enum": ["EQUIVALENT_FOR_DECLARED_SCOPE", "PARTIAL", "NOT_EQUIVALENT", "UNKNOWN"]
        },
        "equivalence_evidence_refs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "file_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "expected_units", "entries"],
      "properties": {
        "content_id": {"$ref": "#/$defs/digest_id"},
        "expected_units": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file_entry"}
        }
      }
    },
    "authority_source_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "receipt_refs": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "digest_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]{16,}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "path",
        "role",
        "availability",
        "revision_status",
        "working_tree_status"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "remote_url": {"type": "string"},
        "availability": {
          "enum": ["PRESENT", "PARTIAL", "EXPECTED_MISSING", "UNEXPECTED_MISSING", "UNKNOWN"]
        },
        "revision_status": {"enum": ["FROZEN", "MOVING", "UNKNOWN"]},
        "commit": {"type": "string"},
        "branch": {"type": "string"},
        "submodules": {"enum": ["CAPTURED", "PARTIAL", "NONE", "UNKNOWN"]},
        "lfs": {"enum": ["CAPTURED", "PARTIAL", "NONE", "UNKNOWN"]},
        "patchset_content_id": {"$ref": "#/$defs/digest_id"},
        "untracked_manifest_content_id": {"$ref": "#/$defs/digest_id"},
        "working_tree_status": {"enum": ["CLEAN", "DIRTY_CAPTURED", "DIRTY_NOT_CAPTURED", "UNKNOWN"]},
        "untracked_files_status": {"enum": ["CAPTURED", "PRESENT_NOT_CAPTURED", "NONE", "UNKNOWN"]},
        "owner": {"type": "string"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"working_tree_status": {"const": "DIRTY_CAPTURED"}}, "required": ["working_tree_status"]},
          "then": {"required": ["patchset_content_id"]}
        },
        {
          "if": {"properties": {"untracked_files_status": {"const": "CAPTURED"}}, "required": ["untracked_files_status"]},
          "then": {"required": ["untracked_manifest_content_id"]}
        }
      ]
    },
    "build_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "purpose", "environment", "completeness"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["TARGET_BUILD", "WINDOWS_PRECHECK", "LANGUAGE_SERVER", "TEST", "OTHER"]},
        "environment": {"type": "string", "minLength": 1},
        "compiler": {"type": "string"},
        "compiler_version": {"type": "string"},
        "target": {"type": "string"},
        "defines_content_id": {"$ref": "#/$defs/digest_id"},
        "include_paths_content_id": {"$ref": "#/$defs/digest_id"},
        "generated_inputs_status": {"enum": ["COMPLETE", "PARTIAL", "MISSING", "UNKNOWN"]},
        "dependency_lock_ref": {"type": "string"},
        "completeness": {"enum": ["COMPLETE_FOR_SCOPE", "PARTIAL", "UNKNOWN"]},
        "receipt_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "path", "content_id", "size_bytes"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_id": {"$ref": "#/$defs/digest_id"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
