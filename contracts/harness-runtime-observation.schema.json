{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/harness-runtime-observation.schema.json",
  "title": "Harness Runtime Observation",
  "description": "A non-authoritative record of what an external Harness actually exposed and executed. It cannot promote a Capability, Gate, Verdict, qualification, or lifecycle state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observation_id",
    "observed_at",
    "adapter_id",
    "harness",
    "model",
    "observer_boundary",
    "execution_environment",
    "checks",
    "ui_checks",
    "conclusion",
    "screenshot"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "HarnessRuntimeObservation"},
    "observation_id": {"type": "string", "pattern": "^hro_[A-Za-z0-9._-]+$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_revision", "version", "surface"],
      "properties": {
        "source_repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_revision": {"type": "string", "pattern": "^[A-Fa-f0-9]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "surface": {"enum": ["WEB", "CLI"]}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "model_id", "configuration_surface", "secret_storage"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "configuration_surface": {"const": "EXTERNAL_CUSTOM_MODEL_UI"},
        "secret_storage": {"const": "HARNESS_UI_ONLY"}
      }
    },
    "observer_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "must_run_after", "review_authority", "claim_authority", "gate_authority", "qualification_authority", "lifecycle_promotion_authority"],
      "properties": {
        "role": {"const": "FINAL_COMPATIBILITY_OBSERVER"},
        "must_run_after": {"const": "TOOLKIT_MULTI_ANGLE_REVIEW"},
        "review_authority": {"const": "NONE"},
        "claim_authority": {"const": "NONE"},
        "gate_authority": {"const": "NONE"},
        "qualification_authority": {"const": "NONE"},
        "lifecycle_promotion_authority": {"const": "NONE"}
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "workspace_root_name", "source_tree_write", "child_process_temp_write", "access_preset"],
      "properties": {
        "platform": {"const": "WINDOWS"},
        "workspace_root_name": {"type": "string", "minLength": 1},
        "source_tree_write": {"const": "DENIED"},
        "child_process_temp_write": {"enum": ["ALLOWED", "DENIED"]},
        "access_preset": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "command", "exit_code", "status"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exit_code": {"type": "integer"},
          "status": {"enum": ["PASSED", "FAILED", "ENVIRONMENT_BLOCKED"]},
          "checks_passed": {"type": "integer", "minimum": 0},
          "checks_total": {"type": "integer", "minimum": 0},
          "error_count": {"type": "integer", "minimum": 0},
          "assertion_failure_count": {"type": "integer", "minimum": 0},
          "limitation": {"type": "string", "minLength": 1}
        }
      }
    },
    "ui_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_discovery", "custom_model_selection", "workspace_registration", "chinese_rendering", "windows_path_rendering"],
      "properties": {
        "skill_discovery": {"$ref": "#/$defs/ui_status"},
        "custom_model_selection": {"$ref": "#/$defs/ui_status"},
        "workspace_registration": {"$ref": "#/$defs/ui_status"},
        "chinese_rendering": {"$ref": "#/$defs/ui_status"},
        "windows_path_rendering": {"$ref": "#/$defs/ui_status"}
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_validation_status", "capability_validation_status", "environment_blocked", "verdict"],
      "properties": {
        "runtime_validation_status": {"const": "PARTIAL"},
        "capability_validation_status": {"const": "NOT_RUN"},
        "environment_blocked": {"type": "boolean"},
        "verdict": {"const": "NONE"}
      }
    },
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_id": {"$ref": "#/$defs/digest_id"}
      }
    }
  },
  "$defs": {
    "ui_status": {"enum": ["PASS", "FAIL", "NOT_CHECKED"]},
    "digest_id": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
  }
}
