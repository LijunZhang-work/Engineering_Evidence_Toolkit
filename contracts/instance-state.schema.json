{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/instance-state.schema.json",
  "title": "Run Instance State",
  "description": "长时间自主任务的可恢复状态。执行状态、Gate、Claim 与最终 Verdict 使用统一词汇；空任务、空 Claim 或空 Gate 不能构成一次运行。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "assurance_policy",
    "mode",
    "execution_status",
    "workspace_snapshot_id",
    "started_at",
    "updated_at",
    "tasks",
    "claims",
    "gates",
    "final_verdict",
    "wait_state",
    "external_failures"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9._-]+$"},
    "assurance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "policy_content_id", "preset", "outcome_authority"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "policy_content_id": {"$ref": "#/$defs/digest_id"},
        "preset": {"enum": ["QUICK", "BALANCED", "STRICT", "CUSTOM"]},
        "outcome_authority": {"enum": ["HINTS_ONLY", "EVIDENCE_REPORT", "FINAL_VERDICT"]}
      }
    },
    "mode": {"enum": ["EXPLORE", "EVIDENCE", "ENFORCE"]},
    "profile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["profile_id", "version", "profile_content_id", "capability_contract_content_ids"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "minLength": 1},
        "profile_content_id": {"$ref": "#/$defs/digest_id"},
        "capability_contract_content_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_id"}
        }
      }
    },
    "execution_status": {
      "enum": ["NOT_STARTED", "BOOTSTRAPPING", "READY", "RUNNING", "WAITING_HUMAN", "BLOCKED", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "workspace_snapshot_id": {"type": "string", "pattern": "^wss_[A-Za-z0-9._-]+$"},
    "collaboration_snapshot_id": {"type": "string", "pattern": "^css_[A-Za-z0-9._-]+$"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "resume_token": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {"required_for_verdict": {"const": true}},
        "required": ["required_for_verdict"]
      },
      "minContains": 1,
      "items": {"$ref": "#/$defs/task_state"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {"required_for_verdict": {"const": true}},
        "required": ["required_for_verdict"]
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_status", "claim_ref", "required_for_verdict"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^cl_[A-Za-z0-9._-]+$"},
          "claim_status": {
            "enum": ["PROVEN", "DISPROVEN", "NOT_PROVEN", "CONFLICTED", "UNKNOWN", "NOT_APPLICABLE"]
          },
          "claim_ref": {"type": "string", "pattern": "^cl_[A-Za-z0-9._-]+$"}
          ,"required_for_verdict": {"type": "boolean"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate_state"}
    },
    "final_verdict": {
      "enum": ["ACCEPT", "ACCEPT_WITH_RISK", "REJECT", "INCOMPLETE", "NO_VERDICT"]
    },
    "collaboration_readiness": {
      "enum": ["ALL_EXPECTED_CODE_PRESENT", "PARTIAL_EXPECTED_CODE", "CODE_EXPECTED_LATER", "UNKNOWN"]
    },
    "mutation_validation_status": {
      "enum": ["NOT_APPLICABLE", "PENDING", "VALIDATED", "FAILED", "UNKNOWN"]
    },
    "wait_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiting_for_user", "reason_code"],
      "properties": {
        "waiting_for_user": {"type": "boolean"},
        "reason_code": {
          "enum": ["NONE", "NEW_AUTHORITY", "SECRET_REQUIRED", "IRREVERSIBLE_DECISION", "SCOPE_EXPANSION", "USER_ONLY_CHOICE"]
        },
        "question": {"type": "string", "minLength": 1},
        "since": {"type": "string", "format": "date-time"},
        "continueable_task_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "diagnostic_receipt_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^rcpt_[A-Za-z0-9._-]+$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"waiting_for_user": {"const": true}}, "required": ["waiting_for_user"]},
          "then": {
            "required": ["question", "since", "diagnostic_receipt_refs"],
            "properties": {
              "reason_code": {"not": {"const": "NONE"}},
              "diagnostic_receipt_refs": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"waiting_for_user": {"const": false}}, "required": ["waiting_for_user"]},
          "then": {"properties": {"reason_code": {"const": "NONE"}}}
        }
      ]
    },
    "external_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_id", "evidence_ref", "applicability_status", "reason", "reconciliation_evidence_refs"],
        "properties": {
          "failure_id": {"type": "string", "pattern": "^xf_[A-Za-z0-9._-]+$"},
          "evidence_ref": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]+$"},
          "applicability_status": {"enum": ["APPLIES", "DOES_NOT_APPLY", "CONFLICTED", "UNKNOWN"]},
          "reason": {"type": "string", "minLength": 1},
          "reconciliation_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]+$"}
          },
          "reconciliation_claim_ref": {
            "type": "string",
            "pattern": "^cl_[A-Za-z0-9._-]+$"
          },
          "reconciliation_receipt_ref": {
            "type": "string",
            "pattern": "^rcpt_[A-Za-z0-9._-]+$"
          },
          "reconciliation_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "REVISION_PATCHSET",
                "TARGET",
                "TOOLCHAIN_FLAGS",
                "HEADERS_GENERATED_DEPENDENCIES",
                "FILE_SYMBOL_PATH",
                "DIFFERENCE_BASIS"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"applicability_status": {"const": "DOES_NOT_APPLY"}},
              "required": ["applicability_status"]
            },
            "then": {
              "required": [
                "reconciliation_claim_ref",
                "reconciliation_receipt_ref",
                "reconciliation_dimensions"
              ],
              "properties": {
                "reconciliation_evidence_refs": {"minItems": 1},
                "reconciliation_dimensions": {
                  "allOf": [
                    {"contains": {"const": "REVISION_PATCHSET"}},
                    {"contains": {"const": "TARGET"}},
                    {"contains": {"const": "TOOLCHAIN_FLAGS"}},
                    {"contains": {"const": "HEADERS_GENERATED_DEPENDENCIES"}},
                    {"contains": {"const": "FILE_SYMBOL_PATH"}},
                    {"contains": {"const": "DIFFERENCE_BASIS"}}
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "checkpoint_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "report_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "run_bundle_digest": {"type": "string", "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]{16,}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "EXPLORE"}}, "required": ["mode"]},
      "then": {"properties": {"final_verdict": {"const": "NO_VERDICT"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "EVIDENCE"}}, "required": ["mode"]},
      "then": {"properties": {"final_verdict": {"enum": ["NO_VERDICT", "INCOMPLETE"]}}}
    },
    {
      "if": {
        "properties": {"final_verdict": {"enum": ["ACCEPT", "ACCEPT_WITH_RISK", "REJECT"]}},
        "required": ["final_verdict"]
      },
      "then": {
        "properties": {
          "mode": {"const": "ENFORCE"},
          "execution_status": {"const": "COMPLETED"}
        }
      }
    }
  ],
  "$defs": {
    "task_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "capability_id", "execution_status", "attempt", "required_for_verdict"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "execution_status": {
          "enum": ["NOT_STARTED", "BOOTSTRAPPING", "READY", "RUNNING", "WAITING_HUMAN", "BLOCKED", "COMPLETED", "FAILED", "CANCELLED"]
        },
        "attempt": {"type": "integer", "minimum": 0},
        "required_for_verdict": {"type": "boolean"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "receipt_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^rcpt_[A-Za-z0-9._-]+$"}
        },
        "error": {"type": "string", "minLength": 1},
        "next_retry_at": {"type": "string", "format": "date-time"}
      }
    },
    "gate_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "gate_status", "reason", "claim_refs", "evidence_refs"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "gate_status": {
          "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE", "WAIVED", "NOT_EVALUATED"]
        },
        "reason": {"type": "string", "minLength": 1},
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^cl_[A-Za-z0-9._-]+$"}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]+$"}
        },
        "waiver_ref": {"type": "string", "pattern": "^wvr_[A-Za-z0-9._-]+$"},
        "applicability_basis_ref": {"type": "string", "pattern": "^cl_[A-Za-z0-9._-]+$"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"gate_status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}},
            "required": ["gate_status"]
          },
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"gate_status": {"const": "WAIVED"}}, "required": ["gate_status"]},
          "then": {"required": ["waiver_ref"]}
        },
        {
          "if": {"properties": {"gate_status": {"const": "NOT_APPLICABLE"}}, "required": ["gate_status"]},
          "then": {"required": ["applicability_basis_ref"]}
        },
        {
          "if": {"properties": {"gate_status": {"const": "NOT_EVALUATED"}}, "required": ["gate_status"]},
          "then": {"properties": {"evidence_refs": {"maxItems": 0}}}
        }
      ]
    },
    "digest_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[A-Fa-f0-9]{16,}$"
    }
  }
}
