{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/waiver.schema.json",
  "title": "Explicit Gate Waiver",
  "description": "Waiver 只记录经授权接受的风险；它不是 PASS 证据，且不能掩盖相互矛盾或用户提供的未解决错误。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "waiver_id",
    "gate_id",
    "status",
    "scope",
    "reason",
    "accepted_risk",
    "authorized_by",
    "authority_ref",
    "issued_at",
    "approval_receipt_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "waiver_id": {"type": "string", "pattern": "^wvr_[A-Za-z0-9._-]+$"},
    "gate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "EXPIRED", "REVOKED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_snapshot_id", "gate_ids", "claim_ids"],
      "properties": {
        "workspace_snapshot_id": {"type": "string", "pattern": "^wss_[A-Za-z0-9._-]+$"},
        "gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^cl_[A-Za-z0-9._-]+$"}}
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "accepted_risk": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approval_receipt_ref": {"type": "string", "pattern": "^rcpt_[A-Za-z0-9._-]+$"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^ev_[A-Za-z0-9._-]+$"}}
  }
}
