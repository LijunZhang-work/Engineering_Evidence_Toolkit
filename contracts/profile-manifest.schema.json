{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/profile-manifest.schema.json",
  "title": "Optional Composition Profile Manifest",
  "description": "可选组合规格。Profile 只能调用 Capability 公共契约，不能读取内部状态或绕过 Capability 直接访问 Provider。",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "status_dimensions", "schema_version", "kind", "id", "version", "title", "intent", "profile_is_optional", "runner_contract", "capability_internal_access", "direct_provider_access", "capabilities"],
  "properties": {
    "status": {"enum": ["DESIGNED", "SCAFFOLDED", "IMPLEMENTED", "VALIDATED", "ACTIVE"]},
    "status_dimensions": {"$ref": "#/$defs/status_dimensions"},
    "status_evidence": {"$ref": "#/$defs/status_evidence"},
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "ToolkitProfile"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "title": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "profile_is_optional": {"const": true},
    "standalone_capability_use_allowed": {"const": true},
    "runner_contract": {"type": "string", "minLength": 1},
    "capability_internal_access": {"const": "forbidden"},
    "direct_provider_access": {"const": "forbidden"},
    "default_mode": {"enum": ["EXPLORE", "EVIDENCE", "ENFORCE"]},
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["EXPLORE", "EVIDENCE", "ENFORCE"]}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"$ref": "#/$defs/capability_ids"},
        "conditional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "when"],
            "properties": {
              "capability": {"$ref": "#/$defs/id"},
              "when": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct_provider_access": {"const": "forbidden"},
        "source_mutation": {"const": "forbidden"},
        "provider_private_state_read": {"const": "forbidden"},
        "unknown_to_pass_promotion": {"const": "forbidden"},
        "complete_review_claim": {"const": "forbidden"}
      }
    },
    "outputs": {"$ref": "#/$defs/nonempty_string_array"},
    "mandatory_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_phrase", "required_once_after_alignment_preview", "does_not_authorize"],
      "properties": {
        "exact_phrase": {"type": "string", "minLength": 1},
        "required_once_after_alignment_preview": {"type": "boolean"},
        "does_not_authorize": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "alignment_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_serialization", "digest", "binds"],
      "properties": {
        "canonical_serialization": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "binds": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/nonempty_string_array"},
          "minProperties": 1
        }
      }
    },
    "execution_model": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 1
    },
    "stages": {"$ref": "#/$defs/nonempty_string_array"},
    "gates": {"$ref": "#/$defs/nonempty_string_array"},
    "gate_result_values": {"$ref": "#/$defs/gate_values"},
    "global_precedence_rules": {"$ref": "#/$defs/nonempty_string_array"},
    "final_verdicts": {"$ref": "#/$defs/verdict_values"},
    "report_views": {"$ref": "#/$defs/nonempty_string_array"},
    "single_fact_source_for_all_views": {"const": true},
    "memory_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_chat_transcript_ingestion",
        "write_requires_explicit_memory_intent",
        "recall_default_scope",
        "use_as_gate_evidence_without_reverification",
        "correction_mode"
      ],
      "properties": {
        "automatic_chat_transcript_ingestion": {"enum": ["forbidden", "explicit_opt_in"]},
        "write_requires_explicit_memory_intent": {"type": "boolean"},
        "recall_default_scope": {"type": "string", "minLength": 1},
        "use_as_gate_evidence_without_reverification": {"const": "forbidden"},
        "correction_mode": {"enum": ["append_and_supersede", "replace_with_audit_trail"]}
      }
    },
    "edit_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_be_explicit", "scope_fields", "forbidden_without_new_authorization"],
      "properties": {
        "must_be_explicit": {"const": true},
        "scope_fields": {"$ref": "#/$defs/nonempty_string_array"},
        "forbidden_without_new_authorization": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "hard_invariants": {"$ref": "#/$defs/nonempty_string_array"},
    "repository_reader_policy": {"type": "string", "minLength": 1},
    "edit_assessment_states": {
      "type": "array",
      "const": [
        "POST_EDIT_EVIDENCE_COMPLETE",
        "POST_EDIT_EVIDENCE_INCOMPLETE",
        "EDIT_NOT_REQUIRED",
        "EDIT_BLOCKED"
      ]
    },
    "assessment_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "rules"],
      "properties": {
        "target": {"const": "CANONICAL_CLAIM_GATE_VERDICT"},
        "rules": {"$ref": "#/$defs/nonempty_string_array"}
      }
    },
    "separate_outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/nonempty_string_array"}
    },
    "hard_rules": {"$ref": "#/$defs/nonempty_string_array"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"supported_modes": {"contains": {"const": "ENFORCE"}}},
        "required": ["supported_modes"]
      },
      "then": {
        "required": [
          "gates",
          "gate_result_values",
          "final_verdicts",
          "report_views",
          "single_fact_source_for_all_views"
        ]
      }
    },
    {
      "if": {"required": ["mandatory_confirmation"]},
      "then": {
        "required": [
          "alignment_lock",
          "execution_model",
          "stages",
          "global_precedence_rules",
          "repository_reader_policy"
        ]
      }
    },
    {
      "if": {"required": ["edit_assessment_states"]},
      "then": {
        "required": [
          "assessment_projection",
          "edit_authorization",
          "hard_invariants",
          "repository_reader_policy"
        ]
      }
    },
    {
      "if": {"required": ["boundaries"]},
      "then": {"required": ["default_mode", "supported_modes", "outputs"]}
    },
    {
      "if": {"required": ["separate_outputs"]},
      "then": {"required": ["hard_rules"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "status_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_status", "implementation_status", "validation_status", "qualification_status", "activation_status"],
      "properties": {
        "specification_status": {"enum": ["DRAFT", "DESIGNED", "REVIEWED", "BASELINED"]},
        "implementation_status": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "IMPLEMENTED"]},
        "validation_status": {"enum": ["NOT_RUN", "PARTIAL", "PASSED", "FAILED", "STALE"]},
        "qualification_status": {"enum": ["NOT_ASSESSED", "UNQUALIFIED", "QUALIFIED_WITH_LIMITS", "QUALIFIED"]},
        "activation_status": {"enum": ["INACTIVE", "ACTIVE", "SUSPENDED", "RETIRED"]}
      }
    },
    "status_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "validation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "qualification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "activation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}}
      }
    },
    "status_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "status_axis", "evidence_kind", "path", "content_id", "result", "observed_at"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status_axis": {"enum": ["implementation", "validation", "qualification", "activation"]},
        "evidence_kind": {"enum": ["IMPLEMENTATION_ARTIFACT", "IMPLEMENTATION_RECEIPT", "TEST_RECEIPT", "QUALIFICATION_RECEIPT", "ACTIVATION_RECEIPT"]},
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "content_id": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "result": {"enum": ["PARTIAL", "IMPLEMENTED", "PASSED", "FAILED", "STALE", "UNQUALIFIED", "QUALIFIED_WITH_LIMITS", "QUALIFIED", "ACTIVE", "SUSPENDED", "RETIRED"]},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "gate_values": {
      "type": "array",
      "const": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE", "WAIVED", "NOT_EVALUATED"]
    },
    "verdict_values": {
      "type": "array",
      "const": ["ACCEPT", "ACCEPT_WITH_RISK", "REJECT", "INCOMPLETE", "NO_VERDICT"]
    }
  }
}
