{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/toolkit-manifest.schema.json",
  "title": "Engineering Evidence Toolkit Manifest",
  "description": "工具包静态设计清单。metadata.status 只表示规格状态；实现、验证和启用状态必须分别声明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "status_dimensions", "status_evidence", "architecture", "entrypoint", "state_file", "shared_contracts", "assurance_policies", "capabilities", "profiles", "adapters", "harness_support_matrix", "lifecycle", "runtime_boundaries", "canonical_policy", "canonical_projection_policy"],
  "properties": {
    "api_version": {"const": "eet/v1"},
    "kind": {"const": "Toolkit"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "chinese_name", "version", "status", "released_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "chinese_name": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "status": {"enum": ["DESIGNED", "SCAFFOLDED", "IMPLEMENTED", "VALIDATED", "ACTIVE"]},
        "released_on": {"type": "string", "format": "date"}
      }
    },
    "status_dimensions": {"$ref": "#/$defs/status_dimensions"},
    "status_evidence": {"$ref": "#/$defs/status_evidence"},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "default_profile", "standalone_invocation_enabled", "profile_required_for_capability_use", "provider_direct_access_by_profile", "capability_private_state_sharing"],
      "properties": {
        "style": {"const": "COMPOSABLE_CAPABILITIES"},
        "default_profile": {"type": ["string", "null"]},
        "standalone_invocation_enabled": {"const": true},
        "profile_required_for_capability_use": {"const": false},
        "provider_direct_access_by_profile": {"const": false},
        "capability_private_state_sharing": {"const": false}
      }
    },
    "entrypoint": {"type": "string", "minLength": 1},
    "state_file": {"type": "string", "minLength": 1},
    "shared_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^contracts/.+\\.schema\\.json$"}},
    "assurance_policies": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^policies/.+\\.yaml$"}
    },
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module_ref"}},
    "profiles": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/module_ref"},
          {"type": "object", "properties": {"default": {"type": "boolean"}}, "required": ["default"]}
        ]
      }
    },
    "adapters": {"type": "array", "items": {"$ref": "#/$defs/module_ref"}},
    "harness_support_matrix": {"const": "adapters/HARNESS_CAPABILITY_MATRIX.yaml"},
    "lifecycle": {
      "allOf": [
        {"$ref": "#/$defs/module_ref"},
        {"type": "object", "properties": {"id": {"const": "toolkit-lifecycle"}, "path": {"const": "lifecycle"}}}
      ]
    },
    "runtime_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outer_execution_boundary", "specification_root", "business_workspace_root", "approved_tool_source_root", "approved_runtime_root", "generated_runs_in_specification_root", "generated_runs_in_business_workspace"],
      "properties": {
        "outer_execution_boundary": {"const": "adapters/company-runtime-boundary/ADAPTER.yaml"},
        "specification_root": {"const": "this_directory"},
        "business_workspace_root": {"const": "external_required"},
        "approved_tool_source_root": {"const": "external_required"},
        "approved_runtime_root": {"const": "external_required"},
        "generated_runs_in_specification_root": {"const": "forbidden"},
        "generated_runs_in_business_workspace": {"const": "forbidden"}
      }
    },
    "canonical_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_contracts_first", "fail_closed_on_conflict", "legacy_documents_are_runtime_entrypoints", "examples_are_operational_evidence"],
      "properties": {
        "machine_contracts_first": {"const": true},
        "fail_closed_on_conflict": {"const": true},
        "legacy_documents_are_runtime_entrypoints": {"const": false},
        "examples_are_operational_evidence": {"const": false}
      }
    },
    "canonical_projection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_source", "adapter_projection_is_derivative", "manual_divergent_copy_forbidden", "release_parity_check_required"],
      "properties": {
        "capability_source": {"const": "capabilities"},
        "adapter_projection_is_derivative": {"const": true},
        "manual_divergent_copy_forbidden": {"const": true},
        "release_parity_check_required": {"const": true}
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "module_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "default": {"type": "boolean"}
      }
    },
    "status_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_status", "implementation_status", "validation_status", "qualification_status", "activation_status"],
      "properties": {
        "specification_status": {"enum": ["DRAFT", "DESIGNED", "REVIEWED", "BASELINED"]},
        "implementation_status": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "IMPLEMENTED"]},
        "validation_status": {"enum": ["NOT_RUN", "PARTIAL", "PASSED", "FAILED", "STALE"]},
        "qualification_status": {"enum": ["NOT_ASSESSED", "UNQUALIFIED", "QUALIFIED_WITH_LIMITS", "QUALIFIED"]},
        "activation_status": {"enum": ["INACTIVE", "ACTIVE", "SUSPENDED", "RETIRED"]}
      }
    },
    "status_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "validation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "qualification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}},
        "activation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/status_evidence_item"}}
      }
    },
    "status_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "status_axis", "evidence_kind", "path", "content_id", "result", "observed_at"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status_axis": {"enum": ["implementation", "validation", "qualification", "activation"]},
        "evidence_kind": {"enum": ["IMPLEMENTATION_ARTIFACT", "IMPLEMENTATION_RECEIPT", "TEST_RECEIPT", "QUALIFICATION_RECEIPT", "ACTIVATION_RECEIPT"]},
        "path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
        "content_id": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "result": {"enum": ["PARTIAL", "IMPLEMENTED", "PASSED", "FAILED", "STALE", "UNQUALIFIED", "QUALIFIED_WITH_LIMITS", "QUALIFIED", "ACTIVE", "SUSPENDED", "RETIRED"]},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
