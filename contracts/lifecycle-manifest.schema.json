{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-evidence.local/schemas/lifecycle-manifest.schema.json",
  "title": "Toolkit Lifecycle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "version", "status_dimensions", "canonical_source", "ownership_contract", "operations", "safety_invariants"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ToolkitLifecycle"},
    "id": {"const": "engineering-evidence-toolkit-lifecycle"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "status_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification_status", "implementation_status", "validation_status", "qualification_status", "activation_status"],
      "properties": {
        "specification_status": {"const": "DESIGNED"},
        "implementation_status": {"enum": ["NOT_IMPLEMENTED", "PARTIAL", "IMPLEMENTED"]},
        "validation_status": {"enum": ["NOT_RUN", "PARTIAL", "PASSED", "FAILED", "STALE"]},
        "qualification_status": {"enum": ["NOT_ASSESSED", "UNQUALIFIED", "QUALIFIED_WITH_LIMITS", "QUALIFIED"]},
        "activation_status": {"enum": ["INACTIVE", "ACTIVE", "SUSPENDED", "RETIRED"]}
      }
    },
    "canonical_source": {"const": "TOOLKIT_MANIFEST.yaml"},
    "ownership_contract": {"const": "contracts/install-state.schema.json"},
    "operations": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "implementation_status", "validation_status", "side_effect", "dry_run_required", "description"],
        "properties": {
          "id": {"enum": ["inventory", "plan", "apply", "doctor", "repair", "uninstall"]},
          "implementation_status": {"enum": ["NOT_IMPLEMENTED", "IMPLEMENTED"]},
          "validation_status": {"enum": ["NOT_RUN", "PASSED", "FAILED", "STALE"]},
          "side_effect": {"enum": ["READ_ONLY", "TOOLKIT_MANAGED_WRITE", "TOOLKIT_MANAGED_REMOVE"]},
          "dry_run_required": {"type": "boolean"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "description": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {"implementation_status": {"const": "IMPLEMENTED"}},
              "required": ["implementation_status"]
            },
            "then": {"required": ["command", "evidence_refs"]}
          },
          {
            "if": {
              "properties": {"validation_status": {"enum": ["PASSED", "FAILED", "STALE"]}},
              "required": ["validation_status"]
            },
            "then": {"required": ["evidence_refs"]}
          }
        ]
      }
    },
    "safety_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
